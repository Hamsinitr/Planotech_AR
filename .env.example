# ==========================================
# Planotech HR - Environment Configuration
# ==========================================

# -----------------
# Backend Settings
# -----------------
# Database connection: SQLite for local dev, PostgreSQL for production
# Local SQLite default: sqlite:///./planotech.db
# PostgreSQL example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./planotech.db

# JWT Security
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server host & port
HOST=0.0.0.0
PORT=8000

# -----------------
# Frontend Settings
# -----------------
# API URL:
# For local browser: leave blank to default to relative /api
# For Android emulator (Capacitor): defaults automatically to http://10.0.2.2:8000/api
# For production cloud deployment (Vercel pointing to Render):
# VITE_API_URL=https://planotech-backend.onrender.com/api
VITE_API_URL=
